# Copy to `.env` (repo root) and fill in what you need.
# Everything defaults to fully-local mode except the LLM.

# ---------- LLM (any OpenAI-compatible endpoint) ----------
# DeepSeek:  https://api.deepseek.com/v1           model: deepseek-chat
# GLM:       https://open.bigmodel.cn/api/paas/v4  model: glm-4-flash
# OpenAI:    https://api.openai.com/v1             model: gpt-4o-mini
# Ollama:    http://localhost:11434/v1             model: qwen2.5:7b   (key: "ollama")
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# Model used for post-session scoring (LLM-as-judge). Defaults to LLM_MODEL.
JUDGE_MODEL=

# ---------- Speech-to-text ----------
# local  -> faster-whisper on this machine
# cloud  -> Deepgram (needs DEEPGRAM_API_KEY)
STT_PROVIDER=local
WHISPER_MODEL=Systran/faster-distil-whisper-small.en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
# Bigger model for the offline (post-session) transcript used for speech metrics.
ANALYSIS_WHISPER_MODEL=small.en

# ---------- Text-to-speech ----------
# kokoro -> local, natural voice     piper -> local, fastest on CPU
# deepgram -> cloud (Aura)
TTS_PROVIDER=kokoro
KOKORO_VOICE=af_heart
PIPER_VOICE=en_US-ryan-high
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_VOICE=aura-2-thalia-en

# ---------- Database ----------
# Leave empty to use an embedded Postgres+pgvector (needs `uv sync --extra embedded-db`).
# With Docker:  postgresql+asyncpg://coach:coach@localhost:5432/coach
DATABASE_URL=

# ---------- Embeddings (question retrieval) ----------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------- WebRTC ----------
# Comma-separated STUN/TURN URLs. Needed only when client and server are on different networks.
ICE_SERVERS=stun:stun.l.google.com:19302

# ---------- Tracing (optional, Langfuse via OpenTelemetry) ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
